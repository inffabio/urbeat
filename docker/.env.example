# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente do docker-compose
# Copie este arquivo para `.env` na mesma pasta e ajuste.
# ─────────────────────────────────────────────────────────────

# Postgres
POSTGRES_PASSWORD=postgres

# JWT (mínimo 32 chars)
JWT_SECRET=CHANGE_ME_REPLACE_WITH_32_PLUS_CHARS_RANDOM_SECRET_KEY_HERE

# Admin do sistema (criado no startup)
ADMIN_EMAIL=admin@urbeat.local
ADMIN_PASSWORD=Admin12345

# Hangfire dashboard (basic auth)
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=urbeat-hangfire

# Encryption (mínimo 32 chars)
ENCRYPTION_KEY=CHANGE_ME_REPLACE_WITH_32_PLUS_CHARS_RANDOM_KEY_HERE_NOW

# Chave dedicada para tokens de promoção de papel (mínimo 32 chars aleatórios).
# Sem valor padrão: a API/workers falham ao iniciar se estiver vazia ou for placeholder.
# Gere com: openssl rand -base64 48
ROLE_PROMOTION_SIGNING_KEY=

# Recuperação administrativa (break-glass). Desativada por padrão.
# O pipeline OCI resolve estes dois nomes exatos no Vault; localmente preencha apenas durante a
# operação manual. Sem chave padrão: com Enabled=false ou Key vazia o endpoint fica indisponível.
AdminRecovery__Enabled=false
AdminRecovery__Key=

# URL pública do frontend (usada em links de confirmação de e-mail)
FRONTEND_BASE_URL=https://urbeat.com.br

# E-mail do administrador (usado pelo Certbot/Let's Encrypt)
LETSENCRYPT_EMAIL=admin@urbeat.com.br

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# SMTP Config
EMAIL_LOGONLY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=true
SMTP_FROM=contato@urbeat.com.br

# Customer verification SMS
CUSTOMER_VERIFICATION_CHANNEL=Sms
CUSTOMER_VERIFICATION_SMS_PROVIDER=Fake
INFOBIP_BASE_URL=https://m9zq59.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SENDER=Urbeat

# WhatsApp Cloud API (Meta). Preencha apenas no ambiente local; em produção os valores vêm do Vault.
# Deixe WebhookEnabled=false enquanto os quatro valores do Vault não estiverem resolvidos:
# a API sobe normalmente e o webhook falha fechado (403/401).
WhatsApp__WebhookEnabled=false
WhatsApp__WebhookVerifyToken=
WhatsApp__AppSecret=
WhatsApp__WabaId=
WhatsApp__AccessToken=
WhatsApp__PhoneNumberId=1436364406224525
WhatsApp__GraphApiVersion=v26.0
# Public Meta App ID (not a secret); required only to refresh the business profile picture.
WhatsApp__MetaAppId=
WhatsApp__ProfilePictureUrl=https://urbeat.com.br/assets/images/urbeat-logo.jpg
