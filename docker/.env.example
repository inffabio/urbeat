# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente do docker-compose
# Copie este arquivo para `.env` na mesma pasta e ajuste.
# ─────────────────────────────────────────────────────────────

# Postgres
POSTGRES_PASSWORD=postgres

# JWT (mínimo 32 chars)
JWT_SECRET=CHANGE_ME_REPLACE_WITH_32_PLUS_CHARS_RANDOM_SECRET_KEY_HERE

# Admin do sistema (criado no startup)
ADMIN_EMAIL=admin@urbeat.local
ADMIN_PASSWORD=Admin12345

# Hangfire dashboard (basic auth)
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=urbeat-hangfire

# Encryption (mínimo 32 chars)
ENCRYPTION_KEY=CHANGE_ME_REPLACE_WITH_32_PLUS_CHARS_RANDOM_KEY_HERE_NOW

# URL pública do frontend (usada em links de confirmação de e-mail)
FRONTEND_BASE_URL=https://urbeat.com.br

# E-mail do administrador (usado pelo Certbot/Let's Encrypt)
LETSENCRYPT_EMAIL=admin@urbeat.com.br

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# SMTP Config
EMAIL_LOGONLY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=true
SMTP_FROM=contato@urbeat.com.br

# Customer verification SMS
CUSTOMER_VERIFICATION_CHANNEL=Sms
CUSTOMER_VERIFICATION_SMS_PROVIDER=Fake
INFOBIP_BASE_URL=https://m9zq59.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SENDER=Urbeat
