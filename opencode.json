{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-4-pro",
  "instructions": ["AGENTS.md"],
  "agent": {
    "desenvolvedor": {
      "description": "Implementa e valida código da aplicação Urbeat usando DeepSeek V4 Pro.",
      "mode": "all",
      "model": "deepseek/deepseek-4-pro"
    },
    "arquiteto": {
      "description": "Define arquitetura e planos da aplicação Urbeat usando ChatGPT 5.6.",
      "mode": "all",
      "model": "openai/chatgpt-5.6"
    }
  },
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  },
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://postgres:991bd2807ec75b66421dc287330f5e46@localhost:15432/urbeat_main"]
    }
  }
}
