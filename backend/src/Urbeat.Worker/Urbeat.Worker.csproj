<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Urbeat.Application\Urbeat.Application.csproj" />
    <ProjectReference Include="..\Urbeat.Infrastructure\Urbeat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure registers ASP.NET Core authorization primitives. The worker hosts them
         without listening on HTTP, so the shared framework must be available. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.12" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

    <!-- Reuse the structured PostgreSQL log configuration owned by the WebApi project. -->
    <None Include="..\Urbeat.WebApi\appsettings.UrbeatLogs.json"
          Link="appsettings.UrbeatLogs.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
