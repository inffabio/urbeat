{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.PostgreSQL"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=localhost;Port=5432;Database=UrbeatLogs;Username=postgres;Password=postgres",
          "tableName": "StructuredLogs",
          "needAutoCreateTable": true,
          "columnWriters": {
            "Id": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.GuidColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Timestamp": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.TimestampColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Level": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.LevelColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Message": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.MessageTemplateColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Application": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Environment": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Endpoint": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "UserId": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "StoreId": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "OrderId": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "EventType": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Exception": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.ExceptionColumnWriter, Serilog.Sinks.PostgreSQL" },
            "CorrelationId": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "TraceId": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "Provider": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" },
            "SourceContext": { "ColumnWriter": "Serilog.Sinks.PostgreSQL.ColumnWriters.RenderedColumnWriter, Serilog.Sinks.PostgreSQL" }
          }
        }
      }
    ]
  }
}
