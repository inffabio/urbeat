# FUTURE HOST TEMPLATE ONLY: installed as sites-available by 05-configure-nginx.ps1.
upstream urbeat_api {
  least_conn;
  server 127.0.0.1:${api_port_1} max_fails=3 fail_timeout=10s;
  server 127.0.0.1:${api_port_2} max_fails=3 fail_timeout=10s;
  keepalive 32;
}
server {
  listen 80;
  listen [::]:80;
  server_name ${api_server_name};
  client_max_body_size ${client_max_body_size};
  location = /health { proxy_pass http://urbeat_api/health; proxy_set_header Host $host; access_log off; }
  location = /health/ready { proxy_pass http://urbeat_api/health/ready; proxy_set_header Host $host; access_log off; }
  location = /health/live { proxy_pass http://urbeat_api/health/live; proxy_set_header Host $host; access_log off; }
  location / { proxy_pass http://urbeat_api; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_read_timeout 300s; }
}
